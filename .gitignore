# One repository for the whole RRFLOW workspace (app, research, coordination, submission).

# Root-only paths are anchored with a leading slash: an unanchored `rrflow/` once
# matched rrflow-app/apps/rrflow and silently dropped the whole app from a commit.
# Rejected previous implementation and its patch: kept locally, never published.
/app-starter/
/brain.patch
# Abandoned empty clone.
/rrflow/

# Third-party source copies imported by the app; not ours to publish.
/research/inputs/

# Secrets live in Infisical only.
.env
.env.*
!.env.example
*.pem
*.key

# Local machine state.
.claude/settings.local.json
.hydradb-plugin-data/
dogfood/.state.json

# Dependencies, builds and test output.
node_modules/
.next/
.next-*/
.turbo/
dist/
build/
coverage/
test-results/
test-results-*/
playwright-report/
*.tsbuildinfo
.DS_Store
Thumbs.db
